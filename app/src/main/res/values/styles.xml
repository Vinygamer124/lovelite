<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="AppTheme" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorAccent">@color/rose</item>
        <item name="android:colorPrimary">@color/rose</item>
        <item name="android:colorControlActivated">@color/rose</item>
        <item name="android:colorButtonNormal">@color/rose_soft</item>
        <item name="android:statusBarColor">@color/rose_dark</item>
        <item name="android:windowBackground">@color/page_bg</item>
        <item name="android:textColorPrimary">@color/ink</item>
    </style>

    <style name="Pill" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_pill</item>
        <item name="android:textColor">@color/rose_dark</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">13sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:paddingLeft">8dp</item>
        <item name="android:paddingRight">8dp</item>
    </style>

    <style name="Primary" parent="android:Widget.Material.Button">
        <item name="android:background">@drawable/btn_primary</item>
        <item name="android:textColor">#FFFFFF</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">15sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
    </style>

    <style name="Section">
        <item name="android:textColor">@color/rose_dark</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.06</item>
        <item name="android:textAllCaps">true</item>
    </style>

    <style name="RowTitle">
        <item name="android:textColor">@color/ink</item>
        <item name="android:textSize">15sp</item>
    </style>

    <style name="RowValue">
        <item name="android:textColor">@color/ink_soft</item>
        <item name="android:textSize">13sp</item>
    </style>

    <style name="Input">
        <item name="android:background">@drawable/bg_input</item>
        <item name="android:padding">12dp</item>
        <item name="android:textColor">@color/ink</item>
        <item name="android:textColorHint">@color/ink_soft</item>
        <item name="android:textSize">15sp</item>
    </style>
</resources>
