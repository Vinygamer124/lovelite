<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="match_parent" android:orientation="vertical">
    <include layout="@layout/topbar"/>
    <FrameLayout android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1">
        <ListView android:id="@+id/list" android:layout_width="match_parent" android:layout_height="match_parent"
            android:clipToPadding="false" android:divider="@null" android:dividerHeight="10dp" android:overScrollMode="never" android:padding="16dp" android:scrollbars="none"/>
        <TextView android:id="@+id/empty" android:layout_width="match_parent" android:layout_height="match_parent" android:gravity="center"
            android:lineSpacingExtra="4dp" android:padding="32dp" android:text="@string/diary_empty" android:textColor="@color/ink_soft" android:textSize="15sp"/>
    </FrameLayout>
</LinearLayout>
