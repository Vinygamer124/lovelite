<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:background="@drawable/topbar_bg" android:elevation="4dp"
    android:gravity="center_vertical" android:orientation="horizontal" android:paddingLeft="4dp" android:paddingRight="12dp">
    <TextView android:id="@+id/tb_back" android:layout_width="48dp" android:layout_height="52dp"
        android:background="?android:attr/selectableItemBackgroundBorderless" android:contentDescription="@string/back"
        android:gravity="center" android:text="‹" android:textColor="#FFFFFF" android:textSize="32sp"/>
    <TextView android:id="@+id/tb_title" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1"
        android:fontFamily="sans-serif-medium" android:singleLine="true" android:textColor="#FFFFFF" android:textSize="19sp"/>
    <TextView android:id="@+id/tb_action" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:background="?android:attr/selectableItemBackground" android:fontFamily="sans-serif-medium"
        android:padding="10dp" android:textColor="#FFFFFF" android:textSize="15sp" android:visibility="gone"/>
</LinearLayout>
