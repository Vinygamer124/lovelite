<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent" android:layout_height="wrap_content"
    android:layout_marginBottom="16dp" android:background="@drawable/bg_card" android:elevation="1dp" android:orientation="vertical" android:padding="18dp">
    <TextView android:id="@+id/f_title" style="@style/Section" android:layout_width="wrap_content" android:layout_height="wrap_content"/>
    <ImageView android:id="@+id/f_avatar" android:layout_width="96dp" android:layout_height="96dp" android:layout_gravity="center_horizontal" android:layout_marginTop="12dp" android:contentDescription="@string/cd_avatar"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_gravity="center_horizontal" android:layout_marginTop="4dp"
        android:text="@string/tap_photo" android:textColor="@color/ink_soft" android:textSize="12sp"/>
    <EditText android:id="@+id/f_name" style="@style/Input" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp"
        android:hint="@string/hint_name" android:imeOptions="actionDone" android:inputType="textPersonName|textCapWords" android:singleLine="true"/>
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="14dp"
        android:text="@string/birthday" android:textColor="@color/ink_soft" android:textSize="12sp"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/f_birth" style="@style/Input" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:clickable="true" android:focusable="true"/>
        <TextView android:id="@+id/f_birth_clear" android:layout_width="44dp" android:layout_height="44dp" android:background="?android:attr/selectableItemBackgroundBorderless" android:gravity="center"
            android:text="✕" android:textColor="@color/ink_soft" android:textSize="16sp" android:visibility="gone"/>
    </LinearLayout>
    <TextView android:id="@+id/f_hint" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_marginTop="6dp"
        android:textColor="@color/rose" android:textSize="13sp" android:visibility="gone"/>
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="14dp" android:orientation="horizontal">
        <TextView android:id="@+id/g_male" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginRight="4dp" android:layout_weight="1" android:background="@drawable/bg_seg"
            android:clickable="true" android:focusable="true" android:fontFamily="sans-serif-medium" android:gravity="center" android:padding="12dp" android:text="@string/gender_male" android:textSize="14sp"/>
        <TextView android:id="@+id/g_female" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:layout_marginRight="4dp" android:layout_weight="1" android:background="@drawable/bg_seg"
            android:clickable="true" android:focusable="true" android:fontFamily="sans-serif-medium" android:gravity="center" android:padding="12dp" android:text="@string/gender_female" android:textSize="14sp"/>
        <TextView android:id="@+id/g_other" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_marginLeft="4dp" android:layout_weight="1" android:background="@drawable/bg_seg"
            android:clickable="true" android:focusable="true" android:fontFamily="sans-serif-medium" android:gravity="center" android:padding="12dp" android:text="@string/gender_other" android:textSize="14sp"/>
    </LinearLayout>
</LinearLayout>
